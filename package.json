{
  "name": "pintortillo",
  "version": "1.0.0",
  "description": "PintORTillo: juego de dibujar y adivinar multijugador en tiempo real (2 a 20 jugadores) con Node.js, Express y Socket.IO.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "online": "node scripts/online.mjs",
    "e2e": "node scripts/e2e.mjs",
    "words": "node scripts/build-words.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
